rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isAdmin() { return request.auth != null && request.auth.token.email == 'bassamomda91@gmail.com'; }

    // User profiles — any signed-in user can read names/avatars; only owner writes
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // Private learning progress — owner only
    match /progress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Community challenges — all signed-in users read; create & member-count updates allowed
    match /challenges/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // Per-user challenge progress
    match /joins/{uid}/items/{id} {
      allow read, write: if isOwner(uid);
    }

    // Community posts — all signed-in users read; author creates; likes update allowed
    match /posts/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Comments on a post — any signed-in family can read & add; owner or admin can delete
      match /comments/{cid} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }

    // Personal block lists — owner only
    match /blocks/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Abuse reports — any signed-in user can file; only you read them (via Firebase console)
    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Public notification marker — latest admin announcement timestamp.
    // Anyone may read (so the badge works even when logged out); only admin writes.
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
